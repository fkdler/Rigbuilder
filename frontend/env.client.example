# ============================================================================
# 客户端设备接入配置（形态 A：每台客户端自跑 dev server）
# 依据 docs/Client_Server_Deployment_Guide_V1.md §4.2。
#
# 用法（在每台客户端设备上执行）：
#   Set-Location <客户端上的仓库路径>\frontend
#   Copy-Item .env.client.example .env -Force
#   npm.cmd install
#   npm.cmd run dev
#   浏览器打开 http://localhost:5173/
#
# 前提：客户端设备上必须能访问服务端设备的 8000 端口 —— 先验证
#   Test-NetConnection <DEVICE_A_IP> -Port 8000     # 期望 TcpTestSucceeded : True
# 失败的话是服务端后端没绑 0.0.0.0、或防火墙没放行该网段（指南 §3.5 / §3.6），
# 与前端配置无关。
#
# 客户端**不要**、也拿不到数据库凭据和推理地址 —— 它们只存在于服务端的 backend/.env。
# ============================================================================

# 留空：所有请求（含 SSE 事件流 GET /api/query/jobs/{id}/events）都走本机 Vite 代理，
# 浏览器视角始终同源，因此本形态下不需要任何 CORS 配置。
VITE_API_BASE_URL=

# 本形态唯一必须改的一项：指向服务端设备的 IP 与 8000 端口。
VITE_API_PROXY_TARGET=http://<DEVICE_A_IP>:8000

# 实际生效的只有这一项（axios 全局超时）。POST /api/query/jobs 是异步提交，
# 立即返回 202，30 s 对提交足够，不需要调大。
VITE_API_TIMEOUT_MS=30000
