# 设备 A（前后端 + PostgreSQL 侧）的前端配置模板。
# 用法：在设备 A 上复制本文件为 frontend/.env 再启动前端。设备 B（推理机）不需要前端配置。
# 留空：浏览器只与 A 的 Vite（:5173）通信，/api 与 /health 由 Vite 代理，保持同源、不需要 CORS。
VITE_API_BASE_URL=

# 代理目标指向设备 A 自身的后端（loopback）。不要写设备 B 的地址，也不要写推理端口 8081/8082。
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

VITE_API_TIMEOUT_MS=30000

# VITE_FUSION_TIMEOUT_MS / VITE_CHAT_TIMEOUT_MS 在当前代码中不起作用（融合已改为异步 Job + SSE），

