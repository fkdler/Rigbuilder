# 设备 A（前后端 + PostgreSQL 侧）的后端配置模板。
# 用法：在设备 A 上复制本文件为 backend/.env 再启动后端。设备 B（推理机）不需要任何配置文件。
#
# 标注说明：
#   [来自设备 B]  必须与设备 B 的启动参数一致，不要自己改；B 换地址/端口时要同步改。
#   [填设备 A]    按设备 A 自己的实际值填写。

# ========== 数据库：设备 A 自己的 PostgreSQL [填设备 A] ==========
DATABASE_URL=postgresql+psycopg://<应用账号>:<口令>@127.0.0.1:5432/rigbuilder
AGENT_READONLY_DATABASE_URL=postgresql+psycopg://<只读账号>:<口令>@127.0.0.1:5432/rigbuilder
# 只读账号由 backend/scripts/create_agent_readonly.py --apply 创建；未配置时查询工具直接拒绝执行。

# ========== 推理：全部指向设备 B [来自设备 B] ==========
# 不要写 127.0.0.1。端口 8081/8082 来自 B 上两个实例的 --port，
# agent-a/agent-b 来自 --alias，必须逐字符一致，否则 chat 报「模型不存在」。
LLM_BASE_URL=http://<DEVICE_B_IP>:8081/v1
LLM_MODEL=agent-a
LLM_TEST_MODEL_IDS=agent-a,agent-b
AGENT_A_BASE_URL=http://<DEVICE_B_IP>:8081/v1
AGENT_A_MODEL=agent-a
AGENT_B_BASE_URL=http://<DEVICE_B_IP>:8082/v1
AGENT_B_MODEL=agent-b
NARRATOR_PROFILE_ID=agent-b
ROUTING_ANALYSIS_ENABLED=true
ROUTING_PROFILE_ID=agent-b
ROUTING_TIMEOUT_SECONDS=20
# B 的两个实例未启用 --api-key，故留空。
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=300
# Stream real provider completion usage into query-job SSE (no token estimation).
LLM_STREAM_USAGE=true
# llama.cpp extension. Set false for providers that reject timings_per_token.
LLM_TIMINGS_PER_TOKEN=true

# ========== 预算 [来自设备 B / 实测校准] ==========
# 必须等于 B 的 --ctx-size（当前 16384），否则报 400。
AGENT_DEFAULT_CONTEXT_SIZE=16384
# Auto-detect the per-slot window from llama.cpp /props; this value is fallback only.
CONTEXT_PROBE_ENABLED=true
CONTEXT_PROBE_TIMEOUT_SECONDS=2
CONTEXT_PROBE_TTL_SECONDS=30
AGENT_MAX_ROUNDS=5
AGENT_MAX_SQL_CALLS=5
AGENT_TOTAL_TIMEOUT_SECONDS=300
FUSION_TOTAL_TIMEOUT_SECONDS=540
TOOL_MAX_RESULT_CHARS=6000
CONTEXT_KEEP_TOOL_ROUNDS=2
# 0 = 只给数据库工具 + JSON-Schema 收尾；实测优于 1（completed 6/6 vs 2/6），no 改。
AGENT_TERMINAL_TOOL_SUPPORTED=0
CONTEXT_COMPRESSION_RATIO=0.70
CONTEXT_RECENT_TURNS=6
# 多轮压缩的触发基准
LLM_CONTEXT_WINDOW_TOKENS=32768
CAPABILITY_SMOKE_ON_STARTUP=0
AGENT_PARALLEL_REQUIRED=0
READONLY_POOL_SIZE=10
READONLY_MAX_OVERFLOW=10

# ========== 对外暴露 [填设备 A] ==========

FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ========== 知乎 [填写设备 A] ==========
ZHIHU_ACCESS_SECRET=
ZHIHU_DAILY_QUERY=显卡日报
ZHIHU_DAILY_AUTHOR_NAME=Wallace
ZHIHU_DAILY_AUTHOR_PROFILE_URL=https://www.zhihu.com/people/mimi-86-49
ZHIHU_DAILY_CACHE_TTL_SECONDS=21600
